$execute if data storage graves:const dimension_names."$(dimension)" run data modify storage graves:main creation.grave_listing.location_text set value ["",{"color":"yellow","text":"($(x_int), $(y_int), $(z_int))","hover_event":{"action":"show_text","value":"Click to teleport to your grave."},"click_event":{"action":"run_command","command":"/trigger graves.tp set $(grave_id)"}},[{"color":"gold","text":" in "},{"storage":"graves:const","nbt":"dimension_names.'$(dimension)'","interpret":true}]]
$execute unless data storage graves:const dimension_names."$(dimension)" run data modify storage graves:main creation.grave_listing.location_text set value ["",{"color":"yellow","text":"($(x_int), $(y_int), $(z_int))","hover_event":{"action":"show_text","value":"Click to teleport to your grave."},"click_event":{"action":"run_command","command":"/trigger graves.tp set $(grave_id)"}},{"color":"gold","text":" in $(dimension)"}]
